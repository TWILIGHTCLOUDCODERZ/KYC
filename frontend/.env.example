# Supabase (Postgres + Storage; auth is bridged from Firebase — see Supabase
# dashboard > Authentication > Sign In / Providers > Third-Party Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase Auth web config — this is PUBLIC by design (Firebase secures access
# via project/API restrictions and Supabase RLS, not by keeping this secret).
# Get these from Firebase Console > Project settings > General > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL of the deployed ocr-backend Cloud Run service (public, non-secret).
VITE_OCR_BACKEND_URL=http://localhost:8080

# NEVER add a secret here (e.g. GEMINI_API_KEY / Supabase service_role key).
# Any VITE_-prefixed variable is baked into the client bundle and shipped to
# every visitor's browser. Real secrets live in GCP Secret Manager and are
# only read server-side by server/ocr-backend (see infra/set-firebase-secret.sh).

# Application
VITE_APP_NAME=NTT DATA Bank
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# AI / OCR Settings
VITE_OCR_CONFIDENCE_THRESHOLD=0.85

# AML Screening
VITE_AML_RISK_THRESHOLD=70

# File Upload
VITE_MAX_FILE_SIZE_MB=10
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Session
VITE_SESSION_TIMEOUT_MINUTES=30
